# Server-side values only. Copy to .env.local and keep real values out of Git.
ELEVENLABS_API_KEY=
# The earlier managed mood agent; not used by the game.
ELEVENLABS_AGENT_ID=
# Game text is written by ElevenLabs Agents (gpt-6.1-terra) with ELEVENLABS_API_KEY. Off unless set to true.
BOARDROOM_AGENTS_ENABLED=
# Local spending cap in US cents, at most 5000 (US$50).
BOARDROOM_AGENTS_CAP_CENTS=
REHEARSAL_ADMIN_TOKEN=
LOCAL_MODEL_URL=http://127.0.0.1:8877
LOCAL_MODEL_TOKEN=

# Shared GPU API: server-side only, no Velocity login required
REHEARSAL_API_URL=https://rehearsal-gpu-lab-team22.arjunb3hl.chatgpt.site
REHEARSAL_SITE_TOKEN=
REHEARSAL_APP_KEY=
