# Copy values into the application's Coolify environment settings.
# Do not use .env or .env.local as a Docker build context or frontend build input.
BOARDROOM_ALLOWED_ORIGINS=https://boardroomcrisis.duckdns.org
# Trust proxy headers only on the private backend network. No backend domain/ports.
FORWARDED_ALLOW_IPS=*

# Fixed by compose.yaml, rather than operator supplied:
# BOARDROOM_SECURE_COOKIE=true
# BOARDROOM_RECORDINGS_DIR=/data/recordings
# BOARDROOM_TTS_LEDGER=/data/voice/ledger.sqlite
# BOARDROOM_TTS_CACHE=/data/voice/tts-cache

# ElevenLabs Agents (gpt-6.1-terra) write the text of the current main game. They use ELEVENLABS_API_KEY below.
BOARDROOM_AGENTS_ENABLED=true
BOARDROOM_AGENTS_CAP_CENTS=5000
BOARDROOM_AGENTS_UNLIMITED=false
# Conversations are opened ahead of a request to save the connection time. Set false to switch that off.
# BOARDROOM_AGENTS_WARM=true
# Optional file path inside the container for a timing log of AI text and speech (see docs/facilitation-api.md).
# BOARDROOM_TIMING_LOG=
# Optional: other agents in the same workspace. Defaults are in backend/app/agent_text.py.
# BOARDROOM_AGENT_WRITER_ID=
# BOARDROOM_AGENT_ANALYST_ID=
# BOARDROOM_AGENT_DRAFTER_ID=
# Fixed persistent path: BOARDROOM_AGENTS_LEDGER=/data/voice/agents/ledger.sqlite

# Existing hosted LFM3 service. Leave blank for the existing offline fallback.
REHEARSAL_API_URL=
REHEARSAL_APP_KEY=
REHEARSAL_SITE_TOKEN=

# Spoken briefing uses the approved cap and verified Flash price fixed in compose.yaml.
# The ElevenLabs key is supplied only through backend runtime settings.
ELEVENLABS_API_KEY=
BOARDROOM_TTS_ENABLED=true
BOARDROOM_STT_ENABLED=false
# With speech to text on, Scribe is told the language (default en; a two or three letter code, or auto to let it guess).
# BOARDROOM_STT_LANGUAGE=en
BOARDROOM_VOICE_BUDGET_USD=100
BOARDROOM_TTS_USD_PER_1K=0.04
BOARDROOM_STT_USD_PER_MINUTE=0
BOARDROOM_TTS_VOICE_ID=
